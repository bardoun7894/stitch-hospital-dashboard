rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public read for hospitals, clinics, doctors (static catalog data)
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /clinics/{clinicId} {
      allow read: if true;
      allow write: if request.auth != null;
      
      match /doctors/{doctorId} {
        allow read: if true;
        allow write: if request.auth != null;
        
        match /dates/{dateId} {
           allow read: if true;
           allow write: if request.auth != null;
        }
      }
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Authenticated access for private data
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }
    
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /queue_states/{queueId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default catch-all (Authenticated only)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}