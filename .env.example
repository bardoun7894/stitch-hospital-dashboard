# =========================================
# ClinicQu Dashboard Configuration
# =========================================

APP_NAME="ClinicQu Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# =========================================
# Logging Configuration
# Production: Set LOG_LEVEL=warning, LOG_CHANNEL=stack
# =========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =========================================
# Database Configuration
# Production: Use MySQL/PostgreSQL
# =========================================
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=clinicqu
# DB_USERNAME=root
# DB_PASSWORD=

# =========================================
# Session & Cache
# =========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# =========================================
# Redis (optional, for caching/queues)
# =========================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =========================================
# Firebase Configuration (REQUIRED)
# Download service account JSON from Firebase Console
# =========================================
FIREBASE_CREDENTIALS=firebase.json
FIREBASE_PROJECT_ID=clinicqu-1e93c

# =========================================
# Stripe Payment Configuration (REQUIRED for production)
# Get keys from Stripe Dashboard
# =========================================
STRIPE_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_SECRET=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# =========================================
# Mail Configuration
# Production: Use SMTP or service like Mailgun/SES
# =========================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@clinicqu.com"
MAIL_FROM_NAME="${APP_NAME}"

# =========================================
# SMS Configuration (optional)
# For queue notifications via SMS
# =========================================
# TWILIO_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_NUMBER=

# =========================================
# AWS (optional, for file storage)
# =========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =========================================
# Frontend Assets
# =========================================
VITE_APP_NAME="${APP_NAME}"
